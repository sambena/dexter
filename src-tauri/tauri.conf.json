{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dexter",
  "version": "0.1.0",
  "identifier": "com.sambena.rom-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dexter",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Sam Bena",
    "shortDescription": "ROM collection manager",
    "longDescription": "Browse, identify and organise a local ROM collection using No-Intro and Redump DAT files.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
